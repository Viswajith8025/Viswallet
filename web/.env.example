# ─── Viswallet Web — Environment Variables ───────────────────────────────────
# Copy to .env.local for local development. Set in your hosting provider for production.

# Public app URL (used for Open Graph metadata and canonical links)
NEXT_PUBLIC_APP_URL=https://viswallet.app

# App version (shown in legal pages; keep in sync with package.json)
NEXT_PUBLIC_APP_VERSION=1.0.0

# ─── Optional: Supabase cloud sync ───────────────────────────────────────────
# Both must be set together. Never commit real values.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Set to "true" only after running supabase/migrations/003_user_data_vaults.sql
# NEXT_PUBLIC_CLOUD_VAULT=false

# ─── Optional: Error reporting (production) ──────────────────────────────────
# POST endpoint that accepts JSON error reports. No financial data is sent.
# Compatible with Sentry tunnel, Logflare, or a custom API route.
# NEXT_PUBLIC_ERROR_REPORT_URL=

# ─── Optional: Privacy-friendly analytics (disabled by default) ──────────────
# Set to "true" to enable anonymous page-view events (path only, no PII).
# NEXT_PUBLIC_ANALYTICS_ENABLED=false
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=

# ─── Server-only secrets (future API routes — NEVER prefix with NEXT_PUBLIC_) ──
# SUPABASE_SERVICE_ROLE_KEY=
# ENCRYPTION_KEY=
