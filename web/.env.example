# ─── Viswallet Web — Environment Variables ───────────────────────────────────
# Copy to .env.local for local development. Set in Vercel → Settings → Environment Variables.

# ─── Production (Vercel) ─────────────────────────────────────────────────────
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# NEXT_PUBLIC_APP_VERSION=1.0.0

# ─── Supabase (set BOTH together) ────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# NEXT_PUBLIC_CLOUD_VAULT=true

# ─── Server-only on Vercel (never NEXT_PUBLIC_) ──────────────────────────────
# GROQ_API_KEY=gsk_...

# ─── Optional ───────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ERROR_REPORT_URL=
# NEXT_PUBLIC_ANALYTICS_ENABLED=false
# NEXT_PUBLIC_ANALYTICS_ENDPOINT=
# SUPABASE_SERVICE_ROLE_KEY=
# ENCRYPTION_KEY=
